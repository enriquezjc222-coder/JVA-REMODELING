{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/.git",
      "**/.git/**",
      "**/node_modules",
      "**/node_modules/**",
      "**/.firebase",
      "**/.firebase/**",
      "functions/**",
      "**/*.zip",
      "**/*.log",
      "**/.env",
      "**/.env.*",
      "**/*.pem",
      "**/*.key",
      "**/*.p12",
      "**/*.pfx",
      "**/*service-account*.json",
      "**/*serviceAccount*.json",
      "**/*secret*.json",
      "**/*credentials*.json",
      "**/*.tmp",
      "**/*.temp",
      "**/*.bak",
      "**/*.swp",
      "**/*~",
      "**/Thumbs.db",
      "*.md",
      "*.txt",
      "firestore.rules",
      "storage.rules",
      "storage-cors.json"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/estimate/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600"
          }
        ]
      }
    ]
  }
}
